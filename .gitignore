# macOS 本地产物（Finder/系统元数据，禁止提交）
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.localized

# Python 字节码与虚拟环境
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
.venv-311/
.venv-build/
.python-version
*.egg-info/

# 测试与覆盖率
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.cache/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# 构建与发布产物
build/
dist/
release/
*.egg
*.whl
*.zip
*.tar.gz
*.spec.bak

# 迁移源：历史项目参考（r2、logistics-cost-skill-2.0），按需另存
migration_sources/

# 数据：数据库、缓存、历史记录、用户图片、导出文件
*.db
*.db-journal
*.sqlite
*.sqlite3
user_data/
user_images/
test_sessions/
cache/
exports/
history/
backups/
data/runtime/
data/feedback/
data/uploads/

# 敏感配置：API key、本地设置、登录态
.env
.env.*
*.key
*.pem
settings.json
settings.local.json
api_keys.local.json
api_profiles.json
api_keys.*.json
cookies*.json
browser_profile/
session_*.json
token_*.json
*.log
logs/
!docs/.gitkeep
!tests/.gitkeep

# 用户下载的原始 .ui 文件存放目录（非项目源码，实际 .ui 在 src/.../ui/forms/）
/ui/

# 视觉/包装评测：真实案例、图片与报告必须放在仓库外数据目录，禁止提交
evaluation-data/
*-evaluation-data/
tests/evaluation/**/real/
tests/evaluation/**/reports/
